<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef ParentName="BlanketBase">
    <defName>CYB_HayBedBlanket</defName>
    <label>hay bed blanket</label>
    <description>Keeps you warm</description>
    <graphicData>
      <texPath>Things/Building/Furniture/Bed/CYB_HayBedBlanket</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <!--<shaderType>CutoutComplex</shaderType>-->
      <drawSize>(1.95,1.85)</drawSize>
	  <drawOffsetEast>(0.1,0,0.03)</drawOffsetEast>
	  <drawOffsetWest>(-0.1,0,0.03)</drawOffsetWest>
	  <drawOffsetSouth>(0,0,-0.08)</drawOffsetSouth>
	  <drawOffsetNorth>(0,0,0.1)</drawOffsetNorth>
      <damageData>
        <rect>(0,0.05,1,1.95)</rect>
      </damageData>
    </graphicData>
    <size>(1,2)</size>
  </ThingDef>
  
