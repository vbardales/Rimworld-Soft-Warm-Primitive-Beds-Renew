<?xml version="1.0" encoding="utf-8"?>
<Defs>

<ThingDef ParentName="BeddingBase">
  <defName>CYB_SingleTribalBedding</defName>
  <label>simple bedding</label>
  <description>Layered blankets to cover a hay bed, making it warmer and more comfortable.</description>
  <graphicData>
	<texPath>Things/Beddings/FurBeddingSingle</texPath>
	<graphicClass>Graphic_Single</graphicClass>
  </graphicData>
  <costStuffCount>72</costStuffCount>
  <stuffCategories>
	<li>Leathery</li>
	<li>Fabric</li>
  </stuffCategories>
  <tradeability>Sellable</tradeability>
  <statBases>
	<MaxHitPoints>100</MaxHitPoints>
	<WorkToMake>400</WorkToMake>
	<Mass>10</Mass>
  </statBases>
  <thingCategories>
	<li>Beddings</li>
  </thingCategories>
  <recipeMaker>
	<recipeUsers>
	  <li>ElectricTailoringBench</li>
	  <li>HandTailoringBench</li>
	  <li>CraftingSpot</li>
	</recipeUsers>
  </recipeMaker>
</ThingDef>

<ThingDef ParentName="BeddingBase">
  <defName>CYB_DoubleTribalBedding</defName>
  <label>large simple bedding</label>
  <description>Layered blankets to cover a double hay bed, making it warmer and more comfortable.</description>
  <graphicData>
	<texPath>Things/Beddings/FurBeddingDouble</texPath>
	<graphicClass>Graphic_Single</graphicClass>
  </graphicData>
  <costStuffCount>120</costStuffCount>
  <stuffCategories>
	<li>Leathery</li>
	<li>Fabric</li>
  </stuffCategories>
  <tradeability>Sellable</tradeability>
  <statBases>
	<MaxHitPoints>100</MaxHitPoints>
	<WorkToMake>800</WorkToMake>
	<Mass>18</Mass>
  </statBases>
  <thingCategories>
	<li>Beddings</li>
  </thingCategories>
  <recipeMaker>
	<recipeUsers>
	  <li>ElectricTailoringBench</li>
	  <li>HandTailoringBench</li>
	  <li>CraftingSpot</li>
	</recipeUsers>
  </recipeMaker>
</ThingDef>

<ThingDef ParentName="BeddingBase">
	<defName>CYB_CribTribalBedding</defName>
	<label>simple crib bedding set</label>
	<description>Tiny layered blankets to fill a hay crib. Provides comfort and insulation for the baby.</description>
	<graphicData>
	  <texPath>Things/Beddings/FurBeddingSingle</texPath>
	  <graphicClass>Graphic_Single</graphicClass>
	  <drawSize>0.6</drawSize>
	</graphicData>
	<costStuffCount>15</costStuffCount>
	<stuffCategories>
	  <li>Fabric</li>
	  <li>Leathery</li>
	</stuffCategories>
	<tradeability>Sellable</tradeability>
	<statBases>
	  <MaxHitPoints>100</MaxHitPoints>
	  <WorkToMake>200</WorkToMake>
	  <Mass>2.5</Mass>
	</statBases>
	<thingCategories>
	  <li>Beddings</li>
	</thingCategories>
	<recipeMaker>
	  <recipeUsers>
		<li>ElectricTailoringBench</li>
		<li>HandTailoringBench</li>
		<li>CraftingSpot</li>
	  </recipeUsers>
	</recipeMaker>
</ThingDef>

</Defs>